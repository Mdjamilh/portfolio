---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Error 404 · Sheet missing</p>
      <h1>This page isn't in the drawings.</h1>
      <p class="lede">The address may have changed. Every project is listed on the projects page, or press <kbd>Ctrl K</kbd> to search.</p>
    </header>
    <div class="actions">
      <a class="button" href="/projects">See all projects</a>
      <a class="button quiet" href="/">Home</a>
    </div>
  </div>
</Base>

<style>
  .actions {
    display: flex;
    gap: 0.7rem;
  }
</style>
