---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import About from "../components/About.astro";
import { GITHUB_USER, projects } from "../data/projects";
import { buildFacts, totals } from "../lib/github";

const facts = await buildFacts(
  GITHUB_USER,
  projects.map((p) => p.slug),
);
---

<Base>
  <Hero figures={totals(facts)} />
  <SelectedWork />
  <ProjectIndex facts={facts} />
  <About />
</Base>
