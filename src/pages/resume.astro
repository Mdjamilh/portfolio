---
import { readdirSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";

/**
 * The resume is whatever PDF is placed in public/resume/ (any file name).
 * With none there yet, the page shows a blank sheet.
 */
let pdf: string | undefined;
try {
  pdf = readdirSync(join(process.cwd(), "public", "resume"))
    .filter((f) => f.toLowerCase().endsWith(".pdf"))
    .sort()[0];
} catch {
  pdf = undefined;
}
const href = pdf ? `/resume/${encodeURIComponent(pdf)}` : undefined;
---

<Base title="Resume" description={`Resume of ${profile.name}.`}>
  <div class="wrap">
    <header class="page-head">
      <p class="label">Sheet 04 · Resume</p>
      <h1>Resume</h1>
      {
        href && (
          <div class="actions">
            <a class="button" href={href} download>
              Download PDF
            </a>
            <a class="button quiet" href={href} target="_blank" rel="noopener">
              Open in a new tab
            </a>
          </div>
        )
      }
    </header>

    <div class="desk">
      {
        href ? (
          <iframe class="sheet" src={`${href}#view=FitH`} title={`Resume of ${profile.name}`} />
        ) : (
          <div class="sheet blank" role="img" aria-label="Resume page" />
        )
      }
    </div>
  </div>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  .desk {
    display: flex;
    justify-content: center;
    padding: clamp(1rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    background: var(--bg-panel);
  }

  /* An A4 sheet: 210 × 297. */
  .sheet {
    display: block;
    width: min(100%, 52rem);
    aspect-ratio: 210 / 297;
    border: 0;
    background: #fff;
    box-shadow: var(--shadow), 0 0 0 1px rgb(0 0 0 / 0.08);
  }
</style>
