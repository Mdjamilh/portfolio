---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { GITHUB_USER, projects, repoUrl, type Project } from "../../data/projects";
import { buildFacts, monthYear } from "../../lib/github";

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, number: i + 1, previous: projects[i - 1], next: projects[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  number: number;
  previous?: Project;
  next?: Project;
}

const { project: p, number, previous, next } = Astro.props;
const facts = (
  await buildFacts(
    GITHUB_USER,
    projects.map((x) => x.slug),
  )
).get(p.slug);
const liveLabel = p.live?.includes("github.com") ? "Download a release" : "Open the live demo";
---

<Base title={p.title} description={p.summary}>
  <article class="case">
    <nav class="crumbs label" aria-label="Breadcrumb">
      <a href="/#index">Index</a> <span aria-hidden="true">/</span> <span aria-current="page">No. {String(number).padStart(2, "0")}</span>
    </nav>

    <header class="head">
      <p class="label domain">{p.domain}</p>
      <h1>{p.title}</h1>
      <p class="summary">{p.summary}</p>
      <div class="actions">
        {p.live && <a class="button" href={p.live}>{liveLabel}</a>}
        <a class="button quiet" href={repoUrl(p.slug)}>Read the source</a>
      </div>
    </header>

    <div class="layout">
      <div class="main">
        <section aria-labelledby="problem">
          <h2 id="problem"><span class="label">I.</span> Problem</h2>
          <p class="lead">{p.problem}</p>
        </section>

        <section aria-labelledby="approach">
          <h2 id="approach"><span class="label">II.</span> Approach</h2>
          <ol class="steps">
            {p.approach.map((a) => <li>{a}</li>)}
          </ol>
        </section>

        <section aria-labelledby="evidence">
          <h2 id="evidence"><span class="label">III.</span> Evidence</h2>
          <ul class="evidence">
            {p.evidence.map((e) => <li>{e}</li>)}
          </ul>
          <p class="note">The repository's README explains how to run each test suite, and its continuous integration history is public.</p>
        </section>
      </div>

      <aside class="facts" aria-label="Project facts">
        <dl>
          <div>
            <dt class="label">Stack</dt>
            <dd>
              <ul class="stack">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
          {
            facts?.commits != null && (
              <div>
                <dt class="label">Commits</dt>
                <dd class="figure">{facts.commits}</dd>
              </div>
            )
          }
          {
            facts?.pushedAt && (
              <div>
                <dt class="label">Last change</dt>
                <dd>{monthYear(facts.pushedAt)}</dd>
              </div>
            )
          }
          <div>
            <dt class="label">Repository</dt>
            <dd>
              <a href={repoUrl(p.slug)}>
                {GITHUB_USER}/{p.slug}
              </a>
            </dd>
          </div>
          {
            p.live && (
              <div>
                <dt class="label">{p.live.includes("github.com") ? "Releases" : "Live"}</dt>
                <dd>
                  <a href={p.live}>{p.live.replace(/^https:\/\//, "")}</a>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>

    <nav class="pager" aria-label="More projects">
      {
        previous ? (
          <a href={`/work/${previous.slug}`} rel="prev">
            <span class="label">Previous</span>
            {previous.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/work/${next.slug}`} rel="next" class="next">
            <span class="label">Next</span>
            {next.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case {
    padding: 2.5rem var(--gutter) 0;
  }

  .crumbs a {
    color: inherit;
  }

  .head {
    max-width: 52rem;
    padding: 3rem 0 3.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .domain {
    color: var(--marker);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .summary {
    margin-top: 1.25rem;
    max-width: 48ch;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 4rem;
    padding-top: 3rem;
  }

  .main section + section {
    margin-top: 3rem;
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 1.6rem;
  }

  h2 .label {
    color: var(--marker);
  }

  .lead {
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .steps {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 0.9rem 0 0.9rem 2.5rem;
    border-top: 1px solid var(--rule);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.05rem;
    font: 500 0.75rem var(--mono);
    color: var(--muted);
  }

  .evidence {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence li {
    position: relative;
    padding: 0.5rem 0 0.5rem 1.75rem;
  }

  .evidence li::before {
    content: "";
    position: absolute;
    left: 0.2rem;
    top: 0.95rem;
    width: 0.7rem;
    height: 0.38rem;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .facts {
    align-self: start;
    position: sticky;
    top: 5.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
  }

  .facts dl {
    margin: 0;
  }

  .facts dl > div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .figure {
    font-family: var(--serif);
    font-size: 1.8rem !important;
    line-height: 1;
  }

  .stack {
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.7;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    text-decoration: none;
  }

  .pager .next {
    text-align: right;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .facts {
      position: static;
    }
  }
</style>
