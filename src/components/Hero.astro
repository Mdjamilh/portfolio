---
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import type { totals } from "../lib/github";

interface Props {
  figures: ReturnType<typeof totals>;
}

const { figures } = Astro.props;
const live = projects.filter((p) => p.live && !p.live.includes("github.com")).length;
const healthcare = projects.filter((p) => p.domain === "Healthcare").length;
const [first, ...rest] = profile.name.split(" ");
---

<section class="hero" aria-labelledby="hero-name">
  <div class="title">
    <p class="label">Portfolio · {new Date().getUTCFullYear()}</p>
    <h1 id="hero-name">
      <span class="first">{first}</span>{" "}{rest.join(" ")}
    </h1>
    <p class="focus">{profile.focus}</p>
  </div>

  <div class="abstract">
    <h2 class="label">Abstract</h2>
    <p>{profile.abstract}</p>
    <p class="keywords"><span class="label">Keywords</span> {profile.keywords.join(" · ")}</p>
    <div class="actions">
      <a class="button" href="#work">Selected work</a>
      <a class="button quiet" href="/resume">Resume</a>
    </div>
  </div>

  <aside class="record" aria-labelledby="record-title">
    <h2 id="record-title" class="label">The record</h2>
    <dl>
      <div>
        <dt>Public repositories</dt>
        <dd>{figures.repositories}</dd>
      </div>
      {
        figures.commits !== null && (
          <div>
            <dt>Commits{figures.complete ? "" : ", counted so far"}</dt>
            <dd>{figures.commits.toLocaleString("en-GB")}</dd>
          </div>
        )
      }
      <div>
        <dt>Live deployments</dt>
        <dd>{live}</dd>
      </div>
      <div>
        <dt>Healthcare projects</dt>
        <dd>{healthcare}</dd>
      </div>
    </dl>
    <p class="note">Each repository runs its tests in continuous integration. Figures are read from GitHub when the site is built.</p>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    grid-template-areas:
      "title title"
      "abstract record";
    gap: 3rem 4rem;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter) 4rem;
    border-bottom: 1px solid var(--rule);
  }

  .title {
    grid-area: title;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 8.5vw, 6.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .first {
    font-style: italic;
    color: var(--ink-soft);
  }

  .focus {
    margin-top: 1.4rem;
    max-width: 40ch;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--ink-soft);
  }

  .abstract {
    grid-area: abstract;
    max-width: var(--measure);
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  .abstract > p:first-of-type {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .keywords {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .keywords .label {
    margin-right: 0.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .record {
    grid-area: record;
    align-self: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  dl {
    margin: 1rem 0 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: "title" "abstract" "record";
      gap: 2.5rem;
    }
  }
</style>
