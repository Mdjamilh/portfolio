---
import { profile } from "../data/profile";

const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
];
// Built pages are files ("/index.html", "/about.html"), so normalise to clean paths first.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/(index)?$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---

<header class="masthead">
  <div class="bar wrap">
    <a class="name" href="/" aria-label={`${profile.name}, home`}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30">
          <rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="M1 9h30M9 1v30" stroke="currentColor" stroke-width="0.75" opacity="0.5"></path>
          <text x="19.5" y="24" font-size="11" font-family="monospace" text-anchor="middle" fill="currentColor">JH</text>
        </svg>
      </span>
      <span class="who">{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <button type="button" class="find" data-open-palette aria-label="Find a page or project" aria-keyshortcuts="Control+K Meta+K /">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <kbd>Ctrl K</kbd>
      </button>
      <button type="button" data-theme-toggle aria-label="Switch to light theme">
        <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // The header is swapped with each page, so the button is bound on every page load.
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
    const root = document.documentElement;
    const show = () => button.setAttribute("aria-label", root.dataset.theme === "light" ? "Switch to dark theme" : "Switch to light theme");
    button.addEventListener("click", () => {
      const light = root.dataset.theme !== "light";
      if (light) root.dataset.theme = "light";
      else delete root.dataset.theme;
      try {
        if (light) localStorage.setItem("theme", "light");
        else localStorage.removeItem("theme");
      } catch {
        // Applied for this page only.
      }
      show();
    });
    show();
  });
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 4rem;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .mark {
    display: flex;
    color: var(--accent);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.45rem 0.8rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    color: var(--accent);
  }

  nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: -0.78rem;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .tools {
    display: flex;
    gap: 0.5rem;
  }

  .tools button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.15rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .tools button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .moon {
    display: none;
  }

  :global(:root[data-theme="light"]) .sun {
    display: none;
  }

  :global(:root[data-theme="light"]) .moon {
    display: block;
  }

  @media (max-width: 820px) {
    .who,
    .find kbd {
      display: none;
    }
    .bar {
      gap: 0.5rem;
    }
    nav a {
      padding: 0.45rem 0.45rem;
      font-size: 0.85rem;
    }
    nav a[aria-current="page"]::after {
      left: 0.45rem;
      right: 0.45rem;
    }
  }

  @media (max-width: 400px) {
    .mark {
      display: none;
    }
  }
</style>
