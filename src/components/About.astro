---
import { profile } from "../data/profile";
---

<section id="about" class="about" aria-labelledby="about-title">
  <header class="section-head">
    <p class="label">§ 3</p>
    <h2 id="about-title">About</h2>
  </header>

  <div class="columns">
    <div class="prose">
      {profile.about.map((p) => <p>{p}</p>)}
    </div>

    <div>
      <h3 class="label">How I work</h3>
      <ol class="principles">
        {
          profile.principles.map((p) => (
            <li>
              <strong>{p.title}.</strong> {p.text}
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="skills">
    <h3 class="label">Technologies used in these projects</h3>
    <dl>
      {
        profile.skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    padding: 4.5rem var(--gutter) 2rem;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem 4rem;
  }

  .prose p {
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .principles {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: principle;
  }

  .principles li {
    position: relative;
    padding: 0.9rem 0 0.9rem 2.2rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    counter-increment: principle;
  }

  .principles li::before {
    content: counter(principle, lower-roman) ".";
    position: absolute;
    left: 0;
    font-family: var(--serif);
    font-style: italic;
    color: var(--marker);
  }

  .principles strong {
    color: var(--ink);
    font-weight: 600;
  }

  .skills {
    margin-top: 3.5rem;
  }

  .skills dl {
    margin: 0.75rem 0 0;
  }

  .skills dl div {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .skills dt {
    font-weight: 500;
  }

  .skills dd {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr;
    }
    .skills dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
