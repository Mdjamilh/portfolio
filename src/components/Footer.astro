---
import { profile } from "../data/profile";
import { repoUrl } from "../data/projects";

const built = new Date().toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<footer class="colophon">
  <div class="wrap grid">
    <div>
      <p class="label">Contact</p>
      <ul>
        {profile.email && <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>}
        <li><a href={profile.github}>GitHub</a></li>
        {profile.linkedin && <li><a href={profile.linkedin}>LinkedIn</a></li>}
      </ul>
    </div>
    <div>
      <p class="label">Title block</p>
      <p>
        Drawn by {profile.name}. Static site built with Astro, self-hosted fonts, no tracking. Figures read from GitHub on {built}.{" "}
        <a href={repoUrl("portfolio")}>Source</a>.
      </p>
    </div>
    <p class="copy label">© {new Date().getUTCFullYear()} {profile.name} · Rev. {built}</p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: auto;
    padding-top: 6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 36rem);
    gap: 1rem 4rem;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .label {
    margin-bottom: 0.5rem;
  }

  .copy {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
