---
/**
 * Fig. 1: the four layers every project here is built through. A signal
 * travels from the database to the tests and each stage lights as it
 * arrives. Pure CSS, so it costs no script and stops for reduced motion.
 */
const stages = [
  { code: "01", title: "Data", detail: "PostgreSQL · pgvector · IndexedDB" },
  { code: "02", title: "API", detail: "Node.js · Python · REST" },
  { code: "03", title: "Interface", detail: "React · Next.js · accessible UI" },
  { code: "04", title: "Verified", detail: "Vitest · Playwright · CI", done: true },
];
---

<figure class="diagram panel" aria-labelledby="fig1">
  <figcaption id="fig1" class="label">Fig. 1 · How each project is built, end to end</figcaption>
  <ol class="stages">
    {
      stages.map((s, i) => (
        <li class="stage">
          <span class="code">{s.code}</span>
          <span class="title">
            {s.title}
            {s.done && (
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </span>
          <span class="detail">{s.detail}</span>
          {i < stages.length - 1 && <span class="wire" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .diagram {
    margin: 0;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  figcaption {
    margin-bottom: 1.4rem;
  }

  .stages {
    --cycle: 6s;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Stagger via position, not inline styles, which the CSP forbids. */
  .stage:nth-child(1) {
    --i: 0;
  }
  .stage:nth-child(2) {
    --i: 1;
  }
  .stage:nth-child(3) {
    --i: 2;
  }
  .stage:nth-child(4) {
    --i: 3;
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 0.95rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--bg);
    animation: light var(--cycle) infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 5);
  }

  .code {
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.12em;
    color: var(--note);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font: 600 1.15rem/1.2 var(--display);
  }

  .title svg {
    color: var(--ok);
  }

  .detail {
    font: 0.74rem/1.45 var(--mono);
    color: var(--muted);
  }

  /* The connector, with a pulse that runs along it after each stage lights. */
  .wire {
    position: absolute;
    top: 50%;
    left: 100%;
    width: 2.5rem;
    height: 1px;
    background: var(--line-strong);
    overflow: visible;
  }

  .wire::after {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px 2px var(--accent-glow);
    opacity: 0;
    animation: travel var(--cycle) infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 5 + var(--cycle) / 10);
  }

  @keyframes light {
    0%,
    22% {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft), 0 0 28px -6px var(--accent-glow);
    }
    32%,
    100% {
      border-color: var(--line-strong);
      box-shadow: none;
    }
  }

  @keyframes travel {
    0% {
      left: 0;
      opacity: 1;
    }
    10% {
      left: calc(100% - 5px);
      opacity: 1;
    }
    11%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .stages {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .wire {
      top: 100%;
      left: 1.5rem;
      width: 1px;
      height: 1.4rem;
    }
    .wire::after {
      animation-name: drop;
    }
    @keyframes drop {
      0% {
        top: 0;
        left: -2px;
        opacity: 1;
      }
      10% {
        top: calc(100% - 5px);
        left: -2px;
        opacity: 1;
      }
      11%,
      100% {
        opacity: 0;
      }
    }
  }
</style>
